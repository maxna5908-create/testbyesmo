<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/byesmo_v3_background</item>
        <item name="android:colorBackground">@color/byesmo_v3_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ByeSmoV3.Starting.Base" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/byesmo_v3_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/byesmo_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.ByeSmoV3.PostSplash</item>
        <item name="android:windowBackground">@color/byesmo_v3_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="p">@android:color/transparent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.ByeSmoV3.Starting" parent="Theme.ByeSmoV3.Starting.Base"/>

    <style name="Theme.ByeSmoV3.PostSplash" parent="Theme.MyApplication">
        <item name="android:windowBackground">@color/byesmo_v3_background</item>
        <item name="android:colorBackground">@color/byesmo_v3_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="p">@android:color/transparent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
